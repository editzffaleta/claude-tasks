{
  "name": "claude-tasks",
  "version": "1.0.0",
  "private": true,
  "description": "Quadro central de tarefas de todos os projetos, alimentado pelo Claude via MCP",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "mcp": "node --no-warnings src/mcp.js",
    "test": "node --no-warnings --test test/*.test.js mapa/test/*.test.mjs",
    "i18n:check": "node scripts/i18n.js"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
